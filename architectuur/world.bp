kleur ember-orange {
    naam: "Ember Orange"
    doel: "Primaire warme accentkleur van de Forge-ontwerpidentiteit."
    waarde: "#D86A35"
}

kleur iron-black {
    naam: "Iron Black"
    doel: "Donkere structurele basiskleur van de Forge-ontwerpidentiteit."
    waarde: "#171A1F"
}

kleur smoke-white {
    naam: "Smoke White"
    doel: "Lichte voorgrondkleur voor donkere Forge-oppervlakken."
    waarde: "#ECECEC"
}

palet ember-forge {
    naam: "Ember Forge"
    doel: "Semantisch kleurenpalet voor de Beckeringh Palace Forge-wereld."
    primary: "ember-orange"
    background: "iron-black"
    surface: "iron-black"
    foreground: "smoke-white"
    accent: "ember-orange"
}

typografie forge-interface {
    naam: "Forge Interface"
    doel: "Typografische rollen voor digitale Forge-producten."
    heading: "Aptos Display"
    body: "Aptos"
    mono: "JetBrains Mono"
}

typeschaal forge-type-scale {
    naam: "Forge Type Scale"
    doel: "Semantische tekstgroottes voor digitale Forge-producten."
    display: "64px"
    title: "40px"
    heading: "28px"
    body: "16px"
    label: "14px"
    caption: "12px"
}

materiaal forge-materials {
    naam: "Forge Materials"
    doel: "Materiële kleurrollen voor Forge-oppervlakken en accenten."
    canvas: "iron-black"
    surface: "iron-black"
    raised: "iron-black"
    foreground: "smoke-white"
    accent: "ember-orange"
}

border forge-borders {
    naam: "Forge Borders"
    doel: "Lijndiktes en lijnstijl voor Forge-producten."
    hairline: "1px"
    regular: "2px"
    strong: "3px"
    style: "solid"
}

radius forge-radius {
    naam: "Forge Radius"
    doel: "Afrondingsschaal voor Forge-componenten."
    small: "4px"
    medium: "12px"
    large: "24px"
    pill: "999px"
}

shadow forge-shadows {
    naam: "Forge Shadows"
    doel: "Diepteschaal voor Forge-oppervlakken."
    low: "0 2px 8px #00000040"
    medium: "0 8px 24px #00000059"
    high: "0 20px 48px #00000073"
}

motion forge-motion {
    naam: "Forge Motion"
    doel: "Tijds- en easingprofiel voor rustige Forge-interacties."
    fast: "120ms"
    normal: "220ms"
    slow: "420ms"
    easing: "cubic-bezier(0.2, 0.8, 0.2, 1)"
}

spacing forge-spacing {
    naam: "Forge Spacing"
    doel: "Ruimtelijke schaal voor Forge-componenten en composities."
    none: "0"
    xs: "4px"
    small: "8px"
    medium: "16px"
    large: "24px"
    xl: "40px"
}

thema forge {
    naam: "Forge"
    doel: "Nordic forge-ontwerpidentiteit voor Beckeringh Palace."
    palet: "ember-forge"
    typografie: "forge-interface"
    typeschaal: "forge-type-scale"
    materiaal: "forge-materials"
    border: "forge-borders"
    radius: "forge-radius"
    shadow: "forge-shadows"
    motion: "forge-motion"
    spacing: "forge-spacing"
}

wereld beckeringh-palace {
    naam: "Beckeringh Palace"
    doel: "Eén reproduceerbare digitale ontwerpwereld leveren."
    thema: "forge"
}

token color-ember {
    naam: "Ember"
    doel: "Primaire warme accentkleur voor de Forge-identiteit."
    type: "color"
    waarde: "#D86A35"
}

token color-iron {
    naam: "Iron"
    doel: "Donkere structurele basiskleur."
    type: "color"
    waarde: "#171A1F"
}

token color-smoke {
    naam: "Smoke"
    doel: "Lichte voorgrondkleur voor donkere oppervlakken."
    type: "color"
    waarde: "#ECECEC"
}

token color-accent {
    naam: "Accent"
    doel: "Semantische accentkleur die naar de Forge-kleur verwijst."
    type: "color"
    waarde: "{color-ember}"
}

token radius-medium {
    naam: "Medium radius"
    doel: "Standaard afronding voor productcomponenten."
    type: "dimension"
    waarde: "12px"
}

token typography-family-forge-interface {
    naam: "Forge interface font family"
    doel: "Hoofdlettertype voor digitale Forge-producten."
    type: "font-family"
    waarde: "Aptos"
}

appearance forge-panel-appearance {
    naam: "Forge Panel Appearance"
    doel: "Semantisch appearance-contract voor verhoogde Forge-panelen."
    material: "raised"
    foreground: "foreground"
    accent: "accent"
    border: "regular"
    radius: "medium"
    shadow: "medium"
    motion: "normal"
    spacing: "small"
    heading-style: "heading"
    body-style: "body"
    label-style: "label"
    caption-style: "caption"
}

appearance forge-panel-compact-appearance {
    naam: "Forge Panel Compact Appearance"
    doel: "Compact paneelprofiel met minder ruimte en diepte."
    material: "raised"
    foreground: "foreground"
    accent: "accent"
    border: "regular"
    radius: "medium"
    shadow: "low"
    motion: "normal"
    spacing: "xs"
    heading-style: "heading"
    body-style: "body"
    label-style: "label"
    caption-style: "caption"
}

component forge-panel {
    naam: "Forge Panel"
    doel: "Basispaneel voor dashboards en productdocumentatie."
    appearance: "forge-panel-appearance"
}

variant forge-panel-compact {
    naam: "Forge Panel Compact"
    doel: "Gecontroleerde compacte appearance voor een Forge-paneel."
    component: "forge-panel"
    appearance: "forge-panel-compact-appearance"
}

compositie forge-dashboard {
    naam: "Forge Dashboard"
    doel: "Eerste reproduceerbare productsamenstelling."
    instanties: ["forge-dashboard-left-panel", "forge-dashboard-center-panel", "forge-dashboard-right-panel"]
}

componentinstantie forge-dashboard-left-panel {
    naam: "Architectuurobjecten"
    doel: "Aantal objecten in het gevalideerde BAT wereldmodel."
    compositie: "forge-dashboard"
    component: "forge-panel"
    metric-kind: "*"
}

componentinstantie forge-dashboard-center-panel {
    naam: "Design tokens"
    doel: "Aantal native tokens waaruit de Forge producten worden gegenereerd."
    compositie: "forge-dashboard"
    component: "forge-panel"
    variant: "forge-panel-compact"
    metric-kind: "token"
}

componentinstantie forge-dashboard-right-panel {
    naam: "Productuitvoer"
    doel: "Aantal productdefinities met een expliciete backend."
    compositie: "forge-dashboard"
    component: "forge-panel"
    metric-kind: "product"
}

layout forge-dashboard-ultrawide {
    naam: "Forge Dashboard Ultrawide"
    doel: "Ordent de drie Forge-dashboardpanelen in een semantisch grid."
    type: "grid"
    regions: ["forge-dashboard-left", "forge-dashboard-center", "forge-dashboard-right"]
    columns: "3"
    rows: "1"
}

region forge-dashboard-left {
    naam: "Linkerpaneel"
    doel: "Linker dashboardregio."
    layout: "forge-dashboard-ultrawide"
    instantie: "forge-dashboard-left-panel"
    column: "1"
    row: "1"
    column-span: "1"
    row-span: "1"
}

region forge-dashboard-center {
    naam: "Middenpaneel"
    doel: "Centrale dashboardregio."
    layout: "forge-dashboard-ultrawide"
    instantie: "forge-dashboard-center-panel"
    column: "2"
    row: "1"
    column-span: "1"
    row-span: "1"
}

region forge-dashboard-right {
    naam: "Rechterpaneel"
    doel: "Rechter dashboardregio."
    layout: "forge-dashboard-ultrawide"
    instantie: "forge-dashboard-right-panel"
    column: "3"
    row: "1"
    column-span: "1"
    row-span: "1"
}

product forge-dashboard-html {
    naam: "Forge Dashboard HTML"
    doel: "Het ultrawide Forge-dashboard via de HTML-backend genereren."
    backend: "html"
    wereld: "beckeringh-palace"
    compositie: "forge-dashboard"
    layout: "forge-dashboard-ultrawide"
    pad: "output/products/forge-dashboard.html"
}

product forge-dashboard-grafana {
    naam: "Forge Dashboard Grafana"
    doel: "Het Forge-dashboard als importeerbaar Grafana dashboard genereren."
    backend: "grafana"
    wereld: "beckeringh-palace"
    compositie: "forge-dashboard"
    layout: "forge-dashboard-ultrawide"
    pad: "output/products/forge-dashboard.grafana.json"
}

renderdoel css-tokens {
    naam: "CSS design tokens"
    doel: "Design tokens als CSS custom properties genereren."
    formaat: "css"
    pad: "output/products/tokens.css"
}

renderdoel json-tokens {
    naam: "Portable design tokens"
    doel: "Design tokens platformneutraal als JSON genereren."
    formaat: "json"
    pad: "output/products/tokens.json"
}

renderdoel css-components {
    naam: "CSS components"
    doel: "Componenten als reproduceerbare CSS-klassen genereren."
    formaat: "css"
    pad: "output/products/components.css"
}

renderdoel html-components {
    naam: "HTML component catalogue"
    doel: "Een minimale componentcatalogus genereren."
    formaat: "html"
    pad: "output/products/components.html"
}
