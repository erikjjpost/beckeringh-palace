    waarde: "#A5DEFB"
}

kleur sky-soft {
    naam: "Soft Cyan Surface"
    doel: "Zacht cyaan oppervlak voor ghost bediening en informatieve status."
    waarde: "#7DD3FC0F"
}

kleur sky-500 {
    naam: "Pressed Cyan"
