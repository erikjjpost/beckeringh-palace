wereld beckeringh-palace {
    naam: "Beckeringh Palace"
    doel: "Eén reproduceerbare digitale ontwerpwereld leveren."
}

token color-ember {
    naam: "Ember"
    doel: "Primaire warme accentkleur voor de Forge-identiteit."
    type: "color"
    waarde: "#D86A35"
}

token color-iron {
    naam: "Iron"
    doel: "Donkere structurele basiskleur."
    type: "color"
    waarde: "#171A1F"
}

token color-smoke {
    naam: "Smoke"
    doel: "Lichte voorgrondkleur voor donkere oppervlakken."
    type: "color"
    waarde: "#ECECEC"
}

token color-accent {
    naam: "Accent"
    doel: "Semantische accentkleur die naar de Forge-kleur verwijst."
    type: "color"
    waarde: "{color-ember}"
}

token spacing-unit {
    naam: "Spacing unit"
    doel: "Basiseenheid voor reproduceerbare tussenruimte."
    type: "dimension"
    waarde: "8px"
}

token radius-medium {
    naam: "Medium radius"
    doel: "Standaard afronding voor productcomponenten."
    type: "dimension"
    waarde: "12px"
}

token typography-family-default {
    naam: "Default font family"
    doel: "Standaardlettertype voor de digitale wereld."
    type: "font-family"
    waarde: "Aptos"
}

component forge-panel {
    naam: "Forge Panel"
    doel: "Basispaneel voor dashboards en productdocumentatie."
    surface: "{color-iron}"
    foreground: "{color-smoke}"
    accent: "{color-accent}"
    padding: "{spacing-unit}"
    radius: "{radius-medium}"
}

renderdoel css-tokens {
    naam: "CSS design tokens"
    doel: "Design tokens als CSS custom properties genereren."
    formaat: "css"
    pad: "output/products/tokens.css"
}

renderdoel json-tokens {
    naam: "Portable design tokens"
    doel: "Design tokens platformneutraal als JSON genereren."
    formaat: "json"
    pad: "output/products/tokens.json"
}

renderdoel css-components {
    naam: "CSS components"
    doel: "Componenten als reproduceerbare CSS-klassen genereren."
    formaat: "css"
    pad: "output/products/components.css"
}

renderdoel html-components {
    naam: "HTML component catalogue"
    doel: "Een minimale componentcatalogus genereren."
    formaat: "html"
    pad: "output/products/components.html"
}
