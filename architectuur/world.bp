kleur ember-orange {
    naam: "Ember Orange"
    doel: "Primaire warme accentkleur van de Forge-ontwerpidentiteit."
    waarde: "#D86A35"
}

kleur iron-black {
    naam: "Iron Black"
    doel: "Donkere structurele basiskleur van de Forge-ontwerpidentiteit."
    waarde: "#171A1F"
}

kleur smoke-white {
    naam: "Smoke White"
    doel: "Lichte voorgrondkleur voor donkere Forge-oppervlakken."
    waarde: "#ECECEC"
}

palet ember-forge {
    naam: "Ember Forge"
    doel: "Semantisch kleurenpalet voor de Beckeringh Palace Forge-wereld."
    primary: "ember-orange"
    background: "iron-black"
    surface: "iron-black"
    foreground: "smoke-white"
    accent: "ember-orange"
}

typografie forge-interface {
    naam: "Forge Interface"
    doel: "Typografische rollen voor digitale Forge-producten."
    heading: "Aptos Display"
    body: "Aptos"
    mono: "JetBrains Mono"
}

materiaal forge-materials {
    naam: "Forge Materials"
    doel: "Materiële kleurrollen voor Forge-oppervlakken en accenten."
    canvas: "iron-black"
    surface: "iron-black"
    raised: "iron-black"
    foreground: "smoke-white"
    accent: "ember-orange"
}

border forge-borders {
    naam: "Forge Borders"
    doel: "Lijndiktes en lijnstijl voor Forge-producten."
    hairline: "1px"
    regular: "2px"
    strong: "3px"
    style: "solid"
}

radius forge-radius {
    naam: "Forge Radius"
    doel: "Afrondingsschaal voor Forge-componenten."
    small: "4px"
    medium: "12px"
    large: "24px"
    pill: "999px"
}

shadow forge-shadows {
    naam: "Forge Shadows"
    doel: "Diepteschaal voor Forge-oppervlakken."
    low: "0 2px 8px #00000040"
    medium: "0 8px 24px #00000059"
    high: "0 20px 48px #00000073"
}

motion forge-motion {
    naam: "Forge Motion"
    doel: "Tijds- en easingprofiel voor rustige Forge-interacties."
    fast: "120ms"
    normal: "220ms"
    slow: "420ms"
    easing: "cubic-bezier(0.2, 0.8, 0.2, 1)"
}

thema forge {
    naam: "Forge"
    doel: "Nordic forge-ontwerpidentiteit voor Beckeringh Palace."
    palet: "ember-forge"
    typografie: "forge-interface"
    materiaal: "forge-materials"
    border: "forge-borders"
    radius: "forge-radius"
    shadow: "forge-shadows"
    motion: "forge-motion"
}

wereld beckeringh-palace {
    naam: "Beckeringh Palace"
    doel: "Eén reproduceerbare digitale ontwerpwereld leveren."
    thema: "forge"
}

token color-ember {
    naam: "Ember"
    doel: "Primaire warme accentkleur voor de Forge-identiteit."
    type: "color"
    waarde: "#D86A35"
}

token color-iron {
    naam: "Iron"
    doel: "Donkere structurele basiskleur."
    type: "color"
    waarde: "#171A1F"
}

token color-smoke {
    naam: "Smoke"
    doel: "Lichte voorgrondkleur voor donkere oppervlakken."
    type: "color"
    waarde: "#ECECEC"
}

token color-accent {
    naam: "Accent"
    doel: "Semantische accentkleur die naar de Forge-kleur verwijst."
    type: "color"
    waarde: "{color-ember}"
}

token spacing-unit {
    naam: "Spacing unit"
    doel: "Basiseenheid voor reproduceerbare tussenruimte."
    type: "dimension"
    waarde: "8px"
}

token radius-medium {
    naam: "Medium radius"
    doel: "Standaard afronding voor productcomponenten."
    type: "dimension"
    waarde: "12px"
}

token typography-family-forge-interface {
    naam: "Forge interface font family"
    doel: "Hoofdlettertype voor digitale Forge-producten."
    type: "font-family"
    waarde: "Aptos"
}

appearance forge-panel-appearance {
    naam: "Forge Panel Appearance"
    doel: "Semantisch appearance-contract voor verhoogde Forge-panelen."
    material: "raised"
    foreground: "foreground"
    accent: "accent"
    border: "regular"
    radius: "medium"
    shadow: "medium"
    motion: "normal"
}

component forge-panel {
    naam: "Forge Panel"
    doel: "Basispaneel voor dashboards en productdocumentatie."
    appearance: "forge-panel-appearance"
    padding: "{spacing-unit}"
}

compositie forge-dashboard {
    naam: "Forge Dashboard"
    doel: "Eerste reproduceerbare productsamenstelling."
    componenten: ["forge-panel", "forge-panel", "forge-panel"]
    richting: "row"
}

layout forge-dashboard-ultrawide {
    naam: "Forge Dashboard Ultrawide"
    doel: "Backend-onafhankelijk canvas voor het Forge-dashboard."
    compositie: "forge-dashboard"
    canvas-width: "3840"
    canvas-height: "1080"
}

regio forge-dashboard-left {
    naam: "Linkerpaneel"
    doel: "Linker dashboardregio."
    layout: "forge-dashboard-ultrawide"
    component: "forge-panel"
    x: "80"
    y: "120"
    width: "1120"
    height: "840"
}

regio forge-dashboard-center {
    naam: "Middenpaneel"
    doel: "Centrale dashboardregio."
    layout: "forge-dashboard-ultrawide"
    component: "forge-panel"
    x: "1360"
    y: "120"
    width: "1120"
    height: "840"
}

regio forge-dashboard-right {
    naam: "Rechterpaneel"
    doel: "Rechter dashboardregio."
    layout: "forge-dashboard-ultrawide"
    component: "forge-panel"
    x: "2640"
    y: "120"
    width: "1120"
    height: "840"
}

product forge-dashboard-html {
    naam: "Forge Dashboard HTML"
    doel: "Het ultrawide Forge-dashboard via de HTML-backend genereren."
    backend: "html"
    wereld: "beckeringh-palace"
    layout: "forge-dashboard-ultrawide"
    pad: "output/products/forge-dashboard.html"
}

renderdoel css-tokens {
    naam: "CSS design tokens"
    doel: "Design tokens als CSS custom properties genereren."
    formaat: "css"
    pad: "output/products/tokens.css"
}

renderdoel json-tokens {
    naam: "Portable design tokens"
    doel: "Design tokens platformneutraal als JSON genereren."
    formaat: "json"
    pad: "output/products/tokens.json"
}

renderdoel css-components {
    naam: "CSS components"
    doel: "Componenten als reproduceerbare CSS-klassen genereren."
    formaat: "css"
    pad: "output/products/components.css"
}

renderdoel html-components {
    naam: "HTML component catalogue"
    doel: "Een minimale componentcatalogus genereren."
    formaat: "html"
    pad: "output/products/components.html"
}

renderdoel css-compositions {
    naam: "CSS compositions"
    doel: "Compositielayouts als CSS genereren."
    formaat: "css"
    pad: "output/products/compositions.css"
}

renderdoel html-compositions {
    naam: "HTML compositions"
    doel: "Composities als zelfstandig HTML-product genereren."
    formaat: "html"
    pad: "output/products/compositions.html"
}

renderdoel svg-compositions {
    naam: "SVG compositions"
    doel: "Composities als reproduceerbaar vectorcanvas genereren."
    formaat: "svg"
    pad: "output/products/compositions.svg"
}

renderdoel html-spatial {
    naam: "Spatial HTML product"
    doel: "Het Spatial Model als exact gepositioneerd HTML-product genereren."
    formaat: "html"
    pad: "output/products/spatial.html"
}
