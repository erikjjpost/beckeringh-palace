kleur ink-900 {
    naam: "Deep Night Blue"
    doel: "Standaardachtergrond van de EmberForge ontwerpidentiteit."
    waarde: "#0F1724"
}

kleur ink-800 {
    naam: "Graphite"
    doel: "Primair UI oppervlak van de EmberForge ontwerpidentiteit."
    waarde: "#1F2937"
}

kleur ink-700 {
    naam: "Steel Blue"
    doel: "Verhoogd kaart en paneeloppervlak."
    waarde: "#243447"
}

kleur ink-600 {
    naam: "Divider Blue"
    doel: "Hairline en scheidingskleur op donkere oppervlakken."
    waarde: "#2F4259"
}

kleur sky-400 {
    naam: "Cyan Accent"
    doel: "Primaire interactie en highlightkleur."
    waarde: "#7DD3FC"
}

kleur bone-50 {
    naam: "Ice White"
    doel: "Primaire tekstkleur op donkere oppervlakken."
    waarde: "#E6EDF5"
}

kleur bone-300 {
    naam: "Secondary Ice"
    doel: "Secundaire tekstkleur op donkere oppervlakken."
    waarde: "#B8C5D6"
}

kleur ember-500 {
    naam: "Ember Copper"
    doel: "Spaarzame warme Forge accentkleur."
    waarde: "#C9895B"
}

kleur status-success {
    naam: "Success Green"
    doel: "Semantische succeskleur."
    waarde: "#4ADE80"
}

kleur status-warning {
    naam: "Warning Amber"
    doel: "Semantische waarschuwingskleur, onderscheiden van Ember."
    waarde: "#E0B341"
}

kleur status-error {
    naam: "Danger Red"
    doel: "Semantische foutkleur."
    waarde: "#F87171"
}

palet ember-forge {
    naam: "Ember Forge"
    doel: "Gecontroleerd gemigreerd semantisch kleurenpalet van EmberForge."
    primary: "sky-400"
    background: "ink-900"
    surface: "ink-800"
    foreground: "bone-50"
    accent: "ember-500"
    success: "status-success"
    warning: "status-warning"
    error: "status-error"
}

typografie forge-interface {
    naam: "Forge Interface"
    doel: "Typografische rollen voor digitale Forge-producten."
    heading: "Aptos Display"
    body: "Aptos"
    mono: "JetBrains Mono"
}

typeschaal forge-type-scale {
    naam: "Forge Type Scale"
    doel: "Semantische tekstgroottes voor digitale Forge-producten."
    display: "64px"
    title: "40px"
    heading: "28px"
    body: "16px"
    label: "14px"
    caption: "12px"
}

materiaal forge-materials {
    naam: "Forge Materials"
    doel: "Gecontroleerd gemigreerde EmberForge materiaalrollen."
    canvas: "ink-900"
    surface: "ink-800"
    raised: "ink-700"
    foreground: "bone-50"
    muted: "bone-300"
    accent: "ember-500"
    outline: "ink-600"
}

border forge-borders {
    naam: "Forge Borders"
    doel: "Gecontroleerd gemigreerde EmberForge lijnhiërarchie."
    hairline: "1px"
    regular: "1px"
    strong: "1px"
    style: "solid"
}

radius forge-radius {
    naam: "Forge Radius"
    doel: "Gecontroleerd gemigreerde EmberForge afrondingsschaal."
    small: "4px"
    medium: "12px"
    large: "16px"
    pill: "999px"
}

shadow forge-shadows {
    naam: "Forge Shadows"
    doel: "Gecontroleerd gemigreerde EmberForge diepteschaal."
    low: "0 1px 2px rgba(0,0,0,0.25)"
    medium: "0 6px 18px rgba(0,0,0,0.35)"
    high: "0 18px 44px rgba(0,0,0,0.45)"
}

motion forge-motion {
    naam: "Forge Motion"
    doel: "Gecontroleerd gemigreerd EmberForge tijds- en easingprofiel."
    fast: "120ms"
    normal: "220ms"
    slow: "420ms"
    easing: "cubic-bezier(0.2, 0.7, 0.2, 1)"
}

spacing forge-spacing {
    naam: "Forge Spacing"
    doel: "Gecontroleerd gemigreerde EmberForge ruimte op een 4px-basis."
    none: "0"
    xs: "4px"
    small: "8px"
    medium: "16px"
    large: "32px"
    xl: "64px"
}

artdirection emberforge-art-direction {
    naam: "EmberForge Art Direction"
    doel: "Rustige soevereine control room met ruime duisternis en schaarse warmte."
    canvas: "canvas"
    interaction: "primary"
    warm-accent: "accent"
    warm-accent-limit: "2"
    glow: "controlled"
    ornament: "technical-linework"
    density: "spacious"
    imagery: "isometric-line-art"
}

thema forge {
    naam: "Forge"
    doel: "Nordic forge-ontwerpidentiteit voor Beckeringh Palace."
    palet: "ember-forge"
    typografie: "forge-interface"
    typeschaal: "forge-type-scale"
    materiaal: "forge-materials"
    border: "forge-borders"
    radius: "forge-radius"
    shadow: "forge-shadows"
    motion: "forge-motion"
    spacing: "forge-spacing"
    artdirection: "emberforge-art-direction"
}

wereld beckeringh-palace {
    naam: "Beckeringh Palace"
    doel: "Eén reproduceerbare digitale ontwerpwereld leveren."
    thema: "forge"
}

merk emberforge {
    naam: "EmberForge"
    doel: "Merkidentiteit voor de soevereine infrastructuur binnen Beckeringh Palace."
    tagline: "Sovereign Infrastructure."
    belofte: "Sovereignty over your own stack."
    principes: ["Own your data.", "Own your nodes.", "Own your forge."]
    producten: ["Homelab Dashboard", "Keycloak login", "CV Database", "ISMS Challenger", "Roadmap", "Marketing en merkoppervlakken"]
    taal: "Nederlands met technische termen in het Engels"
    stem: "Zelfverzekerd, technisch en rustig"
}

token color-ember {
    naam: "Ember Copper"
    doel: "Ruwe warme accentkleur uit het EmberForge bronpalet."
    type: "color"
    waarde: "#C9895B"
}

token color-iron {
    naam: "Deep Night Blue"
    doel: "Ruwe achtergrondkleur uit het EmberForge bronpalet."
    type: "color"
    waarde: "#0F1724"
}

token color-smoke {
    naam: "Ice White"
    doel: "Ruwe voorgrondkleur uit het EmberForge bronpalet."
    type: "color"
    waarde: "#E6EDF5"
}

token color-sky {
    naam: "Cyan Accent"
    doel: "Ruwe primaire interactiekleur uit het EmberForge bronpalet."
    type: "color"
    waarde: "#7DD3FC"
}

token color-background {
    naam: "Background"
    doel: "Semantische EmberForge achtergrondkleur."
    type: "color"
    waarde: "{color-iron}"
}

token color-primary {
    naam: "Primary"
    doel: "Semantische EmberForge interactiekleur."
    type: "color"
    waarde: "{color-sky}"
}

token color-foreground {
    naam: "Foreground"
    doel: "Semantische EmberForge voorgrondkleur."
    type: "color"
    waarde: "{color-smoke}"
}

token color-accent {
    naam: "Accent"
    doel: "Semantische accentkleur die naar de Forge-kleur verwijst."
    type: "color"
    waarde: "{color-ember}"
}

token radius-medium {
    naam: "Medium radius"
    doel: "Standaard afronding voor productcomponenten."
    type: "dimension"
    waarde: "12px"
}

token typography-family-forge-interface {
    naam: "Forge interface font family"
    doel: "Hoofdlettertype voor digitale Forge-producten."
    type: "font-family"
    waarde: "Aptos"
}

appearance forge-panel-appearance {
    naam: "Forge Panel Appearance"
    doel: "Semantisch appearance-contract voor verhoogde Forge-panelen."
    material: "raised"
    foreground: "foreground"
    accent: "accent"
    border: "regular"
    radius: "medium"
    shadow: "medium"
    motion: "normal"
    spacing: "small"
    heading-style: "heading"
    body-style: "body"
    label-style: "label"
    caption-style: "caption"
}

appearance forge-panel-compact-appearance {
    naam: "Forge Panel Compact Appearance"
    doel: "Compact paneelprofiel met minder ruimte en diepte."
    material: "raised"
    foreground: "foreground"
    accent: "accent"
    border: "regular"
    radius: "medium"
    shadow: "low"
    motion: "normal"
    spacing: "xs"
    heading-style: "heading"
    body-style: "body"
    label-style: "label"
    caption-style: "caption"
}

appearance forge-panel-hero-appearance {
    naam: "Forge Panel Hero Appearance"
    doel: "Ruime en verhoogde appearance voor de homepage-entree."
    material: "raised"
    foreground: "foreground"
    accent: "accent"
    border: "strong"
    radius: "large"
    shadow: "high"
    motion: "slow"
    spacing: "xl"
    heading-style: "display"
    body-style: "body"
    label-style: "label"
    caption-style: "caption"
}

component forge-panel {
    naam: "Forge Panel"
    doel: "Basispaneel voor dashboards en productdocumentatie."
    appearance: "forge-panel-appearance"
}

variant forge-panel-compact {
    naam: "Forge Panel Compact"
    doel: "Gecontroleerde compacte appearance voor een Forge-paneel."
    component: "forge-panel"
    appearance: "forge-panel-compact-appearance"
}

variant forge-panel-hero {
    naam: "Forge Panel Hero"
    doel: "Gecontroleerde hero-appearance voor de homepage-entree."
    component: "forge-panel"
    appearance: "forge-panel-hero-appearance"
}

variant forge-panel-route {
    naam: "Forge Panel Route"
    doel: "Gecontroleerde routekaart-appearance voor homepage-navigatie."
    component: "forge-panel"
    appearance: "forge-panel-compact-appearance"
}

informatiegebied palace-world {
    naam: "Wereld en identiteit"
    doel: "De digitale wereld, haar merk en haar reproduceerbare bronassets."
    toegankelijkheidslabel: "Wereld en identiteit, overzicht van wereld, merk en bronassets"
    leesvolgorde: "1"
    soorten: ["wereld", "merk", "asset"]
    inhoud: ["beckeringh-palace"]
    navigatie: ["forge-dashboard-html", "forge-dashboard-grafana"]
}

informatiegebied forge-design-system {
    naam: "Forge ontwerpsysteem"
    doel: "De ontwerpprimitieven, tokens en componentcontracten van de Forge-identiteit."
    toegankelijkheidslabel: "Forge ontwerpsysteem, overzicht van ontwerpprimitieven en componenten"
    leesvolgorde: "2"
    soorten: ["kleur", "palet", "typografie", "typeschaal", "materiaal", "border", "radius", "shadow", "motion", "spacing", "thema", "appearance", "token", "component", "variant"]
    inhoud: ["forge", "forge-materials", "forge-panel"]
    navigatie: ["html-components", "css-components", "css-tokens", "json-tokens"]
}

informatiegebied palace-product-family {
    naam: "Productfamilie"
    doel: "De composities, layouts en uitvoerproducten die uit dezelfde wereld worden gegenereerd."
    toegankelijkheidslabel: "Productfamilie, overzicht van composities, layouts en uitvoerproducten"
    leesvolgorde: "3"
    soorten: ["homepagegebied", "compositie", "componentinstantie", "layout", "region", "product", "renderdoel"]
    inhoud: ["forge-dashboard", "forge-dashboard-ultrawide", "project-status-html"]
    navigatie: ["project-status-html", "project-status-grafana"]
}

compositie forge-dashboard {
    naam: "Forge Dashboard"
    doel: "Informatiearchitectuur van de Beckeringh Palace wereld, het Forge ontwerpsysteem en de productfamilie."
    instanties: ["forge-dashboard-left-panel", "forge-dashboard-center-panel", "forge-dashboard-right-panel"]
}

componentinstantie forge-dashboard-left-panel {
    naam: "Wereld en identiteit"
    doel: "De digitale wereld, haar merk en haar reproduceerbare bronassets."
    compositie: "forge-dashboard"
    component: "forge-panel"
    informatiegebied: "palace-world"
}

componentinstantie forge-dashboard-center-panel {
    naam: "Forge ontwerpsysteem"
    doel: "De ontwerpprimitieven, tokens en componentcontracten van de Forge-identiteit."
    compositie: "forge-dashboard"
    component: "forge-panel"
    variant: "forge-panel-compact"
    informatiegebied: "forge-design-system"
}

componentinstantie forge-dashboard-right-panel {
    naam: "Productfamilie"
    doel: "De composities, layouts en uitvoerproducten die uit dezelfde wereld worden gegenereerd."
    compositie: "forge-dashboard"
    component: "forge-panel"
    informatiegebied: "palace-product-family"
}

layout forge-dashboard-ultrawide {
    naam: "Forge Dashboard Ultrawide"
    doel: "Ordent de drie Forge-dashboardpanelen in een semantisch grid."
    type: "grid"
    regions: ["forge-dashboard-left", "forge-dashboard-center", "forge-dashboard-right"]
    columns: "3"
    rows: "1"
}

region forge-dashboard-left {
    naam: "Linkerpaneel"
    doel: "Linker dashboardregio."
    layout: "forge-dashboard-ultrawide"
    instantie: "forge-dashboard-left-panel"
    column: "1"
    row: "1"
    column-span: "1"
    row-span: "1"
}

region forge-dashboard-center {
    naam: "Middenpaneel"
    doel: "Centrale dashboardregio."
    layout: "forge-dashboard-ultrawide"
    instantie: "forge-dashboard-center-panel"
    column: "2"
    row: "1"
    column-span: "1"
    row-span: "1"
}

region forge-dashboard-right {
    naam: "Rechterpaneel"
    doel: "Rechter dashboardregio."
    layout: "forge-dashboard-ultrawide"
    instantie: "forge-dashboard-right-panel"
    column: "3"
    row: "1"
    column-span: "1"
    row-span: "1"
}

product forge-dashboard-html {
    naam: "Forge Dashboard HTML"
    doel: "Het ultrawide Forge-dashboard via de HTML-backend genereren."
    backend: "html"
    mode: "static"
    wereld: "beckeringh-palace"
    compositie: "forge-dashboard"
    layout: "forge-dashboard-ultrawide"
    pad: "output/products/forge-dashboard.html"
}

product forge-dashboard-grafana {
    naam: "Forge Dashboard Grafana"
    doel: "Het Forge-dashboard als importeerbaar Grafana dashboard genereren."
    backend: "grafana"
    mode: "static"
    wereld: "beckeringh-palace"
    compositie: "forge-dashboard"
    layout: "forge-dashboard-ultrawide"
    pad: "output/products/forge-dashboard.grafana.json"
}

product project-status-html {
    naam: "Beckeringh Palace Projectstatus"
    doel: "De normatieve projectvoortgang als reproduceerbaar HTML product ontsluiten."
    backend: "html"
    mode: "static"
    inhoud: "project-status"
    wereld: "beckeringh-palace"
    compositie: "forge-dashboard"
    layout: "forge-dashboard-ultrawide"
    pad: "output/products/project-status.html"
}

product project-status-grafana {
    naam: "Beckeringh Palace Projectstatus Grafana"
    doel: "De normatieve projectvoortgang als reproduceerbaar Grafana dashboard ontsluiten."
    backend: "grafana"
    mode: "static"
    inhoud: "project-status"
    wereld: "beckeringh-palace"
    compositie: "forge-dashboard"
    layout: "forge-dashboard-ultrawide"
    pad: "output/products/project-status.grafana.json"
}

compositie beckeringh-palace-homepage-composition {
    naam: "Beckeringh Palace"
    doel: "Toegangspoort tot de digitale wereld, het ontwerpsysteem en de actuele projectstatus."
    instanties: ["homepage-intro", "homepage-world", "homepage-design-system", "homepage-project-status"]
}

homepagegebied homepage-entrance {
    naam: "Design is data"
    doel: "Introduceert de ontwerpregel achter alle Beckeringh Palace producten."
    rol: "entree"
    componentrol: "hero"
    component: "forge-panel"
    variant: "forge-panel-hero"
    leesvolgorde: "1"
    focusvolgorde: "0"
    navigatiegedrag: "geen"
    kernboodschap: "Design is data."
    merk: "emberforge"
}

homepagegebied homepage-world-area {
    naam: "Digitale wereld"
    doel: "Verken de samenhang tussen wereld, identiteit en productfamilie."
    rol: "route"
    componentrol: "routekaart"
    component: "forge-panel"
    variant: "forge-panel-route"
    leesvolgorde: "2"
    focusvolgorde: "1"
    navigatiegedrag: "volledige-kaart"
    kernboodschap: "Eén normatief wereldmodel verbindt identiteit, ontwerp en producten."
    navigatie: "forge-dashboard-html"
}

homepagegebied homepage-design-system-area {
    naam: "Forge ontwerpsysteem"
    doel: "Bekijk de reproduceerbare componenten en ontwerpprimitieven."
    rol: "route"
    componentrol: "routekaart"
    component: "forge-panel"
    variant: "forge-panel-route"
    leesvolgorde: "3"
    focusvolgorde: "2"
    navigatiegedrag: "volledige-kaart"
    kernboodschap: "Tokens, appearances en componenten vormen één reproduceerbaar ontwerpsysteem."
    navigatie: "html-components"
}

homepagegebied homepage-project-status-area {
    naam: "Projectstatus"
    doel: "Volg de actuele voortgang, onderbouwing en eerstvolgende milestone."
    rol: "route"
    componentrol: "routekaart"
    component: "forge-panel"
    variant: "forge-panel-route"
    leesvolgorde: "4"
    focusvolgorde: "3"
    navigatiegedrag: "volledige-kaart"
    kernboodschap: "Voortgang en vervolgstappen komen uit dezelfde normatieve projectstatus."
    navigatie: "project-status-html"
}

componentinstantie homepage-intro {
    compositie: "beckeringh-palace-homepage-composition"
    homepagegebied: "homepage-entrance"
}

componentinstantie homepage-world {
    compositie: "beckeringh-palace-homepage-composition"
    homepagegebied: "homepage-world-area"
}

componentinstantie homepage-design-system {
    compositie: "beckeringh-palace-homepage-composition"
    homepagegebied: "homepage-design-system-area"
}

componentinstantie homepage-project-status {
    compositie: "beckeringh-palace-homepage-composition"
    homepagegebied: "homepage-project-status-area"
}

layout beckeringh-palace-homepage-grid {
    naam: "Beckeringh Palace Homepage Grid"
    doel: "Ordent de homepage entree en drie productroutes in een responsief grid."
    type: "grid"
    regions: ["homepage-intro-region", "homepage-world-region", "homepage-design-system-region", "homepage-project-status-region"]
    columns: "3"
    rows: "2"
    responsive-breakpoint: "960"
    compact-columns: "1"
}

region homepage-intro-region {
    naam: "Homepage entree"
    doel: "Brede entree tot Beckeringh Palace."
    layout: "beckeringh-palace-homepage-grid"
    instantie: "homepage-intro"
    column: "1"
    row: "1"
    column-span: "3"
    row-span: "1"
    compact-order: "1"
}

region homepage-world-region {
    naam: "Wereldroute"
    doel: "Route naar het wereld en productoverzicht."
    layout: "beckeringh-palace-homepage-grid"
    instantie: "homepage-world"
    column: "1"
    row: "2"
    column-span: "1"
    row-span: "1"
    compact-order: "2"
}

region homepage-design-system-region {
    naam: "Ontwerpsysteemroute"
    doel: "Route naar de componentcatalogus."
    layout: "beckeringh-palace-homepage-grid"
    instantie: "homepage-design-system"
    column: "2"
    row: "2"
    column-span: "1"
    row-span: "1"
    compact-order: "3"
}

region homepage-project-status-region {
    naam: "Statusroute"
    doel: "Route naar de actuele projectstatus."
    layout: "beckeringh-palace-homepage-grid"
    instantie: "homepage-project-status"
    column: "3"
    row: "2"
    column-span: "1"
    row-span: "1"
    compact-order: "4"
}

product beckeringh-palace-homepage {
    naam: "Beckeringh Palace"
    doel: "Homepage en toegangspoort voor de reproduceerbare Beckeringh Palace productwereld."
    backend: "html"
    mode: "static"
    wereld: "beckeringh-palace"
    compositie: "beckeringh-palace-homepage-composition"
