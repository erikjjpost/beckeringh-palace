palet ember-forge {
    naam: "Ember Forge"
    doel: "Gecontroleerd gemigreerd semantisch kleurenpalet van EmberForge."
    primary: "sky-400"
    background: "ink-900"
    surface: "ink-800"
    foreground: "bone-50"
    accent: "ember-500"
    success: "status-success"
    warning: "status-warning"
    error: "status-error"
}

typografie forge-interface {
    naam: "Forge Interface"
    doel: "Gecontroleerd gemigreerde EmberForge fontrollen met lokale fallbacks."
    heading: ["Orbitron", "Iceland", "Bank Gothic", "system-ui", "sans-serif"]
    body: ["Inter", "IBM Plex Sans", "system-ui", "-apple-system", "sans-serif"]
    mono: ["JetBrains Mono", "Fira Code", "SF Mono", "Menlo", "monospace"]
    levering: "local-only"
}

typeschaal forge-type-scale {
    naam: "Forge Type Scale"
    doel: "Gecontroleerd gemigreerde semantische EmberForge tekstgroottes."
    display: "80px"
    title: "56px"
    heading: "32px"
    body: "16px"
    label: "12px"
    caption: "12px"
}

materiaal forge-materials {
    naam: "Forge Materials"
    doel: "Gecontroleerd gemigreerde EmberForge materiaalrollen."
    canvas: "ink-900"
    surface: "ink-800"
    raised: "ink-700"
    field: "ink-950"
    transparent: "transparent-clear"
    foreground: "bone-50"
    muted: "bone-300"
    accent: "ember-500"
    accent-hover: "ember-300"
    outline: "ink-600"
    interaction: "sky-400"
    interaction-hover: "sky-300"
    interaction-soft: "sky-soft"
    interaction-pressed: "sky-500"
    disabled: "ink-500"
    success: "status-success"
    success-surface: "status-success-surface"
    success-foreground: "status-success-foreground"
    warning: "status-warning"
    warning-surface: "status-warning-surface"
    warning-foreground: "status-warning-foreground"
    error: "status-error"
    error-surface: "status-error-surface"
    error-foreground: "status-error-foreground"
    info: "sky-400"
    info-surface: "status-info-surface"
    info-foreground: "sky-300"
}

border forge-borders {
    naam: "Forge Borders"
    doel: "Gecontroleerd gemigreerde EmberForge lijnhiërarchie."
    hairline: "1px"
    regular: "1px"
    strong: "1px"
    style: "solid"
}

radius forge-radius {
    naam: "Forge Radius"
    doel: "Gecontroleerd gemigreerde EmberForge afrondingsschaal."
    small: "4px"
    control: "8px"
    medium: "12px"
    large: "16px"
    pill: "999px"
}

shadow forge-shadows {
    naam: "Forge Shadows"
    doel: "Gecontroleerd gemigreerde EmberForge diepteschaal."
    none: "none"
    low: "0 1px 2px rgba(0,0,0,0.25)"
    medium: "0 6px 18px rgba(0,0,0,0.35)"
    high: "0 18px 44px rgba(0,0,0,0.45)"
    glow: "0 0 0 1px rgba(125,211,252,0.18), 0 6px 24px rgba(125,211,252,0.10)"
    focus: "0 0 0 3px rgba(125,211,252,0.15)"
    glow-accent: "0 0 0 1px rgba(201,137,91,0.30), 0 6px 22px rgba(201,137,91,0.18)"
}

motion forge-motion {
    naam: "Forge Motion"
    doel: "Gecontroleerd gemigreerd EmberForge tijds- en easingprofiel."
    fast: "120ms"
    normal: "220ms"
    slow: "420ms"
    easing: "cubic-bezier(0.2, 0.7, 0.2, 1)"
    rest-offset: "0px"
    hover-offset: "-1px"
}

spacing forge-spacing {
    naam: "Forge Spacing"
    doel: "Gecontroleerd gemigreerde EmberForge ruimte op een 4px-basis."
    none: "0"
    xs: "4px"
    small: "8px"
    medium: "16px"
    large: "32px"
    xl: "64px"
}

artdirection emberforge-art-direction {
    naam: "EmberForge Art Direction"
    doel: "Rustige soevereine control room met ruime duisternis en schaarse warmte."
    canvas: "canvas"
    interaction: "primary"
    warm-accent: "accent"
    warm-accent-limit: "2"
    glow: "controlled"
    ornament: "technical-linework"
    density: "spacious"
    imagery: "isometric-line-art"
}

thema forge {
    naam: "Forge"
