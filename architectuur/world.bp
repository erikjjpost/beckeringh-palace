kleur ink-900 {
    naam: "Deep Night Blue"
    doel: "Standaardachtergrond van de EmberForge ontwerpidentiteit."
    waarde: "#0F1724"
}

kleur ink-950 {
    naam: "Deepest Night"
    doel: "Donker invoeroppervlak binnen EmberForge bediening."
    waarde: "#0A111C"
}

kleur ink-800 {
    naam: "Graphite"
    doel: "Primair UI oppervlak van de EmberForge ontwerpidentiteit."
    waarde: "#1F2937"
}

kleur ink-700 {
    naam: "Steel Blue"
    doel: "Verhoogd kaart en paneeloppervlak."
    waarde: "#243447"
}

kleur ink-600 {
    naam: "Divider Blue"
    doel: "Hairline en scheidingskleur op donkere oppervlakken."
    waarde: "#2F4259"
}

kleur ink-500 {
    naam: "Muted Steel"
    doel: "Gedempte voorgrondkleur voor niet-beschikbare bediening."
